# Copie para .env para rodar no computador. Na Vercel, cadastre estas variáveis em
# Project Settings > Environment Variables (com os MESMOS valores do sistema de produção homolog).

# Mesmo banco MongoDB do sistema de produção. Sem esta variável, o sistema usa a pasta data/ (só para testes locais).
MONGODB_URI=
DB_NAME=casadopadeiro

# Mesma chave do sistema de produção
JWT_SECRET=
